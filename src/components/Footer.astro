---
import Container from "./Container.astro";
import Logo from "./Logo.astro";
import { footerNav, site } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-muted)]">
  <Container class="py-14 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_2fr]">
      <div class="max-w-sm">
        <Logo />
        <p class="mt-4 text-[0.9375rem] leading-relaxed text-[var(--color-ink-3)]">
          A free, fast and private GST calculator for India. Extract the base
          price from an MRP, or add GST to any amount, with instant CGST, SGST
          and IGST breakdowns.
        </p>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {
          footerNav.map((group) => (
            <div>
              <p class="text-[0.8125rem] font-semibold uppercase tracking-wider text-[var(--color-ink)]">
                {group.title}
              </p>
              <ul class="mt-4 space-y-3">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-[0.9375rem] text-[var(--color-ink-3)] transition-colors hover:text-[var(--color-ink)]"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-[var(--color-border)] pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-sm text-[var(--color-ink-3)]">
        &copy; {year} {site.name}. Built for informational use only.
      </p>
      <p class="max-w-xl text-xs leading-relaxed text-[var(--color-ink-4)]">
        Results are estimates based on standard GST formulas. Verify against
        official rules and your accounting software before filing.
      </p>
    </div>
  </Container>
</footer>
