---
/**
 * Button — renders an <a> when `href` is provided, otherwise a <button>.
 * Variants and sizes follow DESIGN.md. Min touch target 44px.
 */
type Variant = "primary" | "secondary" | "ghost";
type Size = "md" | "lg";

interface Props {
  href?: string;
  variant?: Variant;
  size?: Size;
  type?: "button" | "submit" | "reset";
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: className = "",
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-semibold rounded-[var(--radius-md)] transition-[transform,background-color,box-shadow,border-color] duration-200 ease-[var(--ease-standard)] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)] disabled:opacity-50 disabled:pointer-events-none whitespace-nowrap";

const sizes: Record<Size, string> = {
  md: "h-11 px-5 text-[0.9375rem]",
  lg: "h-12 px-6 text-base",
};

const variants: Record<Variant, string> = {
  primary:
    "bg-[var(--color-accent)] text-white shadow-[var(--shadow-sm)] hover:bg-[var(--color-accent-hover)] hover:shadow-[var(--shadow-md)]",
  secondary:
    "bg-[var(--color-surface)] text-[var(--color-ink)] border border-[var(--color-border)] shadow-[var(--shadow-xs)] hover:border-[var(--color-ink-4)] hover:shadow-[var(--shadow-sm)]",
  ghost:
    "bg-transparent text-[var(--color-ink-2)] hover:bg-[var(--color-muted)] hover:text-[var(--color-ink)]",
};

const classes = [base, sizes[size], variants[variant], className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
