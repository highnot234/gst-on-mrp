---
/** Logo — wordmark + mark. Links home unless `asLink` is false. */
interface Props {
  asLink?: boolean;
  class?: string;
}
const { asLink = true, class: className = "" } = Astro.props;
---

<a
  href={asLink ? "/" : undefined}
  class:list={[
    "group inline-flex items-center gap-2.5 rounded-[var(--radius-sm)]",
    className,
  ]}
  aria-label="GST on MRP — home"
>
  <span
    class="grid h-9 w-9 place-items-center rounded-[var(--radius-md)] bg-[var(--color-ink)] text-white shadow-[var(--shadow-sm)] transition-transform duration-200 ease-[var(--ease-standard)] group-hover:-translate-y-0.5"
    aria-hidden="true"
  >
    <svg width="20" height="20" viewBox="0 0 64 64" fill="none">
      <path
        d="M20 22.5c0-1.7 1.4-3 3-3h13v5H25v5h9c1.7 0 3 1.3 3 3v8c0 1.7-1.3 3-3 3H21v-5h11v-4h-9c-1.7 0-3-1.3-3-3v-9z"
        fill="currentColor"></path>
      <circle cx="45" cy="42" r="4" fill="#16a34a"></circle>
    </svg>
  </span>
  <span class="text-[1.0625rem] font-bold tracking-tight text-[var(--color-ink)]">
    GST<span class="text-[var(--color-ink-3)] font-semibold"> on </span>MRP
  </span>
</a>
