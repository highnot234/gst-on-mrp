---
import Container from "./Container.astro";
import Button from "./Button.astro";

const stats = [
  { value: "2", label: "Calculators" },
  { value: "7", label: "GST slabs" },
  { value: "0", label: "Sign-ups" },
];
---

<section class="relative overflow-hidden hero-glow">
  <div class="pointer-events-none absolute inset-0 dot-grid" aria-hidden="true">
  </div>

  <Container class="relative py-[clamp(4rem,9vw,7.5rem)]">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="inline-flex items-center gap-2 rounded-[var(--radius-full)] border border-[var(--color-border)] bg-[var(--color-surface)] px-3.5 py-1.5 text-[0.8125rem] font-medium text-[var(--color-ink-2)] shadow-[var(--shadow-xs)]"
      >
        <span
          class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]"
          aria-hidden="true"></span>
        Reverse GST &amp; Add GST — for India
      </p>

      <h1
        class="mt-6 text-[clamp(2.5rem,6vw,4.25rem)] font-bold leading-[1.05] tracking-[-0.03em] text-[var(--color-ink)]"
      >
        Find the real price behind any&nbsp;MRP
      </h1>

      <p
        class="mx-auto mt-6 max-w-2xl text-[1.125rem] leading-relaxed text-[var(--color-ink-3)]"
      >
        Instantly separate GST from an inclusive price, or add GST to a base
        amount. Get a clean CGST, SGST and IGST breakdown in Indian rupees —
        free, private and lightning fast.
      </p>

      <div
        class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"
      >
        <Button href="/#calculator" variant="primary" size="lg">
          Open calculator
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </Button>
        <Button href="/#how-it-works" variant="secondary" size="lg">
          How it works
        </Button>
      </div>

      <dl
        class="mx-auto mt-14 grid max-w-lg grid-cols-3 gap-4 border-t border-[var(--color-border)] pt-8"
      >
        {
          stats.map((s) => (
            <div class="text-center">
              <dt class="sr-only">{s.label}</dt>
              <dd>
                <span class="tnum block text-2xl font-bold text-[var(--color-ink)]">
                  {s.value}
                </span>
                <span class="mt-1 block text-xs font-medium uppercase tracking-wider text-[var(--color-ink-4)]">
                  {s.label}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Container>
</section>
