---
import Section from "./Section.astro";
import { faqs } from "../data/faqs";

// Auto-generate FAQPage structured data from the same source of truth.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
};
---

<Section
  id="faq"
  eyebrow="FAQ"
  title="Frequently asked questions"
  description="Clear answers on GST, MRP, reverse GST and the CGST, SGST and IGST split."
>
  <div class="mx-auto mt-12 max-w-3xl">
    <ul class="space-y-3" role="list">
      {
        faqs.map((faq, i) => (
          <li>
            <details
              class="group card overflow-hidden transition-shadow duration-200 open:shadow-[var(--shadow-md)]"
            >
              <summary
                class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-[1.0625rem] font-semibold text-[var(--color-ink)] [&::-webkit-details-marker]:hidden"
                aria-expanded="false"
              >
                <span>{faq.question}</span>
                <span
                  class="grid h-7 w-7 shrink-0 place-items-center rounded-[var(--radius-full)] bg-[var(--color-muted)] text-[var(--color-ink-3)] transition-transform duration-200 group-open:rotate-45"
                  aria-hidden="true"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <line x1="5" y1="12" x2="19" y2="12" />
                  </svg>
                </span>
              </summary>
              <div class="px-5 pb-5 pt-0">
                <p class="max-w-prose text-[0.9375rem] leading-relaxed text-[var(--color-ink-2)]">
                  {faq.answer}
                </p>
              </div>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

<script>
  // Sync aria-expanded on <summary> with the <details> open state
  document.querySelectorAll("details").forEach((el) => {
    const summary = el.querySelector("summary");
    if (!summary) return;
    const sync = () => summary.setAttribute("aria-expanded", String(el.open));
    sync();
    el.addEventListener("toggle", sync);
  });
</script>
